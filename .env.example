# ── LLM Configuration ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values

# API Key (required for real LLM calls)
OPENAI_API_KEY=your-api-key-here

# API Base URL
# Options:
#   https://open.bigmodel.cn/api/paas/v4  - 智谱 GLM (default)
#   https://api.z.ai/api/paas/v4          - 智谱国际版 z.ai
#   https://api.stepfun.com/v1            - 阶跃 Step AI
#   https://api.openai.com/v1             - OpenAI
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Model name
# 智谱 GLM: glm-4.6, glm-4.5, glm-4.5-air, glm-4.5-flash
# 阶跃: step-1-8k, step-1-32k, step-1-128k, step-2-16k
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
LLM_MODEL=glm-4.6

# ── Search Provider (Optional) ─────────────────────────────────────
# SerpAPI Key for web search (https://serpapi.com/)
# Leave empty for mock search (demo mode)
SERP_API_KEY=
